{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "cssPriority": "user",
  "ignore-gtk-theme": true,
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",

  "control-center-width": 400,
  "control-center-height": 700,
  "control-center-margin-top": 11,
  "control-center-margin-right": 3,
  "control-center-margin-left": 0,
  "control-center-margin-bottom": 10,

  "notification-window-width": 400,
  "notification-icon-size": 55,
  "notification-body-image-height": 120,
  "notification-body-image-width": 210,

  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 5,

  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "relative-timestamps": true,
  "notification-2fa-action": true,
  "notification-grouping": true,

  "widgets": [
    "dnd",
    "buttons-grid",
    "volume",
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    "dnd": {
      "text": "Do not Disturb"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "mpris": {
      "blacklist": ["playerctld"],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true,
      "image-size": 55,
      "image-radius": 8
    },
    "volume": {
      "label": "󰕾 ",
      "type": "custom",
      "command": "pamixer --get-volume-human",
      "interval": 1
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰕾",
          "type": "toggle",
          "active": false,
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
          "update-command": "sh -c 'pactl get-sink-mute @DEFAULT_SINK@ | grep -q \"no\" && echo true || echo false'"
        },
        {
          "label": "󰌾",
          "command": "hyprlock"
        },
        {
          "label": "󰭹",
          "command": "brave --class=webapp-gemini --app=https://gemini.google.com/"
        }
      ]
    }
  }
}
